# Copy this file to key.properties and fill in your actual values.
# key.properties is gitignored -- NEVER commit it or your .jks keystore to the repo.
#
# To generate a new keystore (run once, then back up the .jks file securely):
#
#   keytool -genkeypair -v \
#     -keystore quickstack-release.jks \
#     -alias quickstack \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
#
# Place the generated .jks file somewhere outside the repo, or in android/ (it is gitignored).
# Then set the values below.

storeFile=../quickstack-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=quickstack
keyPassword=YOUR_KEY_PASSWORD
